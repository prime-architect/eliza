# Assistant Edition environment template
# Copy to .env (gitignored). NEVER commit real secrets — auth values below are
# vault credential handles resolved at runtime, per the model-registry principle
# (§3.7): providers own auth, nothing outside the registry names a model.

# --- System 1 classifiers (plugin-system1, §12) ---
SYSTEM1_LAYA_URL=http://127.0.0.1:8000
SYSTEM1_BACKEND_ORDER=laya,jev
SYSTEM1_ESCALATION_CONFIDENCE=0.8
SYSTEM1_JEV_PROVIDER=openrouter

# OpenRouter API key: do NOT paste here. Provision via the Secure Vault
# (credentials.request_api_access, provider=openrouter) — the registry resolves
# the "vault:openrouter-api-key" handle at runtime.
OPENROUTER_API_KEY=

# --- LaYa sidecar (local, §12.2) ---
LAYA_HOST=127.0.0.1
LAYA_PORT=8000
LAYA_DEVICE=cuda
LAYA_PRELOAD=1
LAYA_DEFAULT_MODEL=english
